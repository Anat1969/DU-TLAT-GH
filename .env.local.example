# ============================================================================
# .env.local.example
# 
# העתק קובץ זה ל-.env.local וממלא את הערכים שלך
# אל תשתף קובץ זה בGit (הוא כולל API Keys)
# ============================================================================

# ============================================================================
# CLAUDE API
# ============================================================================
# קבל ב-https://console.anthropic.com/account/keys
CLAUDE_API_KEY=sk-ant-YOUR_CLAUDE_KEY_HERE

# ============================================================================
# SUPABASE
# ============================================================================
# קבל ב-https://supabase.com/dashboard

# זה הURL של הProject שלך
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# זה הAnon Key (בטוח לשתף בFrontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# זה הService Role Key (סודי, בשרת בלבד)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# TRIPO3D API
# ============================================================================
# קבל ב-https://www.tripo3d.ai/account/settings
TRIPO_API_KEY=your-tripo3d-api-key-here

# ============================================================================
# APP SETTINGS
# ============================================================================

# שם האפליקציה
NEXT_PUBLIC_APP_NAME=Spatial Essence

# גרסה
NEXT_PUBLIC_APP_VERSION=1.0.0

# Environment
NODE_ENV=development

# ============================================================================
# OPTIONAL: External Services
# ============================================================================

# אם תרצה להשתמש בMidjourney API שלישית (APIFRAME או WaveSpeedAI)
# MIDJOURNEY_API_KEY=your-midjourney-api-key-here
# MIDJOURNEY_API_ENDPOINT=https://api.midjourney.com/...

# ============================================================================
# LOGGING (Optional)
# ============================================================================

# רמת logging (debug, info, warn, error)
LOG_LEVEL=debug

# ============================================================================
# דוגמה ערכים של Supabase
# ============================================================================
# 
# אחרי שתקים Supabase Project חדש:
# 
# 1. עבור ל-https://supabase.com/dashboard
# 2. בחר את הProject שלך
# 3. Settings → API
# 4. תראה שם:
#    - Project URL (זה ה-NEXT_PUBLIC_SUPABASE_URL)
#    - Anon Public (זה ה-NEXT_PUBLIC_SUPABASE_ANON_KEY)
#    - Service Role Secret (זה ה-SUPABASE_SERVICE_ROLE_KEY)
# 5. העתק כל אחד לקובץ זה
#
# ============================================================================
